{
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "exclude": ["vite.*", "vitest.*", "dev", "**/__tests__"],
  "compilerOptions": {
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "sourceMap": true,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "outDir": "./lib",
    "stripInternal": true
  }
}
